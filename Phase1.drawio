        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Define Styling and Colors\n    classDef source fill:#f8cecc,stroke:#b85450,stroke-width:2px;\n    classDef acq fill:#fff2cc,stroke:#d6b656,stroke-width:2px;\n    classDef monitors fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px;\n    classDef decision fill:#d5e8d4,stroke:#82b366,stroke-width:2px;\n    classDef selectors fill:#e1d5e7,stroke:#9673a6,stroke-width:1px;\n    classDef engine fill:#ffe6cc,stroke:#d79b00,stroke-width:2px;\n    \n    %% Input Layer\n    subgraph Inputs [\&quot;Input Layer\&quot;]\n        A[\&quot;Input Source&lt;br&gt;• Local Video&lt;br&gt;• YouTube URL&lt;br&gt;• Live Stream\&quot;]:::source\n        B[\&quot;Input Acquisition Layer&lt;br&gt;(Download / Decode)\&quot;]:::acq\n    end\n    \n    %% Telemetry &amp; Analysis Layer\n    subgraph Telemetry [\&quot;Monitoring &amp; Telemetry Layer\&quot;]\n        C[\&quot;Network Monitor&lt;br&gt;• Bandwidth&lt;br&gt;• Bitrate&lt;br&gt;• Latency&lt;br&gt;• Connection Type\&quot;]:::monitors\n        D[\&quot;Device Monitor&lt;br&gt;• CPU Usage&lt;br&gt;• GPU Usage&lt;br&gt;• RAM Usage&lt;br&gt;• Battery&lt;br&gt;• Temperature\&quot;]:::monitors\n        E[\&quot;Scene Analyzer&lt;br&gt;• Motion&lt;br&gt;• Texture&lt;br&gt;• Complexity&lt;br&gt;• Edge Density&lt;br&gt;• Semantic Score\&quot;]:::monitors\n    end\n    \n    %% Decision Layer\n    subgraph Decision [\&quot;Decision Core\&quot;]\n        F[\&quot;Adaptive Decision Engine&lt;br&gt;Multi-Criteria Decision Making&lt;br&gt;(QoE + Resource Optimization)\&quot;]:::decision\n    end\n    \n    %% Allocation Layer\n    subgraph Selectors [\&quot;Selector Controls\&quot;]\n        G[\&quot;Bitrate Selector&lt;br&gt;• 480p / 720p&lt;br&gt;• 1080p&lt;br&gt;• 4K\&quot;]:::selectors\n        H[\&quot;Model Selector&lt;br&gt;• BasicVSR++&lt;br&gt;• Real-ESRGAN&lt;br&gt;• TinySR\&quot;]:::selectors\n        I[\&quot;Scale Selector&lt;br&gt;• ×2&lt;br&gt;•